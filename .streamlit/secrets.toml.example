# 이 파일은 예시입니다. 실제 비밀 값이 들어간 secrets.toml은 절대 GitHub에 올리지 마세요.
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_64_HEX_CHARACTERS"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[app]
teacher_emails = ["teacher@example.com"]

[firebase]
type = "service_account"
project_id = "YOUR_FIREBASE_PROJECT_ID"
private_key_id = "FROM_SERVICE_ACCOUNT_JSON"
private_key = """-----BEGIN PRIVATE KEY-----
REPLACE_WITH_THE_FULL_PRIVATE_KEY_FROM_JSON
-----END PRIVATE KEY-----
"""
client_email = "firebase-adminsdk-XXXXX@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com"
client_id = "FROM_SERVICE_ACCOUNT_JSON"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "FROM_SERVICE_ACCOUNT_JSON"
